  "cards": [
    {
      "dot": "violet",
      "title": "A · Async Executor",
      "items": [
        "每 session 一个 Future；Waker 唤醒仅入去重 Ready 队列",
        "Reactor 交付 Reply 后优先 poll，再检查 timer",
        "Receiver 先消费已收到的回复再处理超时"
      ]
    },
    {
      "dot": "cyan",
      "title": "B · 对照基线",
      "items": [
        "Waiting / Sleeping / Done 状态表，不经过 Executor、Waker",
        "A/B 共用 Shared I/O、Wire、Port 与测量 Recorder"
      ]
    },
    {
      "dot": "amber",
      "title": "实测：64 session，600 秒",
      "items": [
        "A/B 发包速率约 97k packets/s",
        "process 两段和 A−B：p50 = +30ns，p99 = +60ns",
        "数据源：results/ab/SUMMARY.md"
      ]
    },
    {
      "dot": "slate",
      "title": "边界",
      "items": [
        "收发核 2；独立统计核 3，经 SPSC 仅传数值",
        "C 是内核 ping -U，不共用 DPDK PMD",
        "A/C 单会话不能外推为 64 session"
      ]
    }
  ]
