  "cards": [
    {
      "dot": "violet",
      "title": "执行顺序",
      "items": [
        "reactor() → poll_ready() → timers.fire() → poll_ready() → maintenance()",
        "Reply 在 Timer 扫描前先交付 task",
        "Slot::deliver 不同步重入执行 Future"
      ]
    },
    {
      "dot": "cyan",
      "title": "Mbuf 生命周期",
      "items": [
        "Reply 将 RX mbuf 转交 Session，Sample 跨 await 持有",
        "成功 TX 时 PMD 接管 mbuf",
        "TSC 数值传给统计线程，而不是报文内存"
      ]
    },
    {
      "dot": "amber",
      "title": "T0–T5",
      "items": [
        "T0 send，T1 TX burst 返回",
        "T2 RX burst 返回，T3 reply 交付",
        "T4 sleep deadline，T5 session 恢复"
      ]
    }
  ]
